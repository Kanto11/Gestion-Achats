<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.gestion_achats.controller.CommandeDetailsController"
      spacing="15">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Details de la Commande" styleClass="h2"/>

    <GridPane hgap="10" vgap="8">
        <Label text="N° Commande :" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblNumCm" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Fournisseur :" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblFournisseur" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Date commande :" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblDateCm" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Livraison prevue :" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblDateLivraison" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Statut :" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblStatut" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <Label text="Produits commandes" styleClass="h3"/>

    <TableView fx:id="tableLignes" prefHeight="200">
        <columns>
            <TableColumn fx:id="colProduit" text="Produit" prefWidth="180"/>
            <TableColumn fx:id="colQte" text="Quantite" prefWidth="80"/>
            <TableColumn fx:id="colPrixUnitaire" text="Prix unitaire" prefWidth="100"/>
            <TableColumn fx:id="colMontant" text="Montant" prefWidth="100"/>
        </columns>
    </TableView>

    <Label fx:id="lblTotal" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Fermer" onAction="#fermer" styleClass="btn, btn-default"/>
    </HBox>

</VBox>