<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.gestion_achats.controller.EspaceFournisseurControlleur">
    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

    <HBox spacing="10">
         <Button onAction="#actualiserTableau" styleClass="btnRefresh" text="Actualiser" textFill="WHITE">
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.65" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../icons/refresh.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>      
    </HBox>

    <Label fx:id="lblMessage" />

    <TableView fx:id="tableCommandes" styleClass="table-custom" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNumCm" prefWidth="50" text="N°" />
            <TableColumn fx:id="colDateCm" prefWidth="120" text="Date commande" />
            <TableColumn fx:id="colDateLivraison" prefWidth="130" text="Livraison prevue" />
            <TableColumn fx:id="colFournisseur" prefWidth="150" text="Fournisseur" />
            <TableColumn fx:id="colMontantTotal" prefWidth="120" text="Montant total" />
            <TableColumn fx:id="colActions" prefWidth="180" text="Actions" />
        </columns>
    </TableView>

</VBox>
