<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.gestion_achats.controller.PaiementFormController"
      spacing="15">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Enregistrer un Paiement" styleClass="h3"/>

    <Label fx:id="lblInfoCommande" style="-fx-font-weight: bold;"/>
    <Label fx:id="lblResteAPayer"/>

    <GridPane hgap="10" vgap="12">
        <Label text="Montant :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtMontant" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Date :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dateP" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Mode :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboMode" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="lblErreur" textFill="RED" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#annuler" styleClass="btn, btn-default"/>
        <Button text="Enregistrer" onAction="#enregistrer" styleClass="btn, btn-success"/>
    </HBox>

    <Label text="Historique des paiements" styleClass="h3"/>

    <TableView fx:id="tableHistorique" prefHeight="150">
        <columns>
            <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
            <TableColumn fx:id="colMontant" text="Montant" prefWidth="120"/>
            <TableColumn fx:id="colMode" text="Mode" prefWidth="120"/>
        </columns>
    </TableView>

</VBox>